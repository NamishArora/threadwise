# Copy to .env. Never commit your actual .env.
MATTERMOST_URL=http://host.docker.internal:8065
MATTERMOST_BOT_TOKEN=
MATTERMOST_SUMMARIZE_SLASH_TOKEN=
MATTERMOST_EMAIL_SLASH_TOKEN=
MATTERMOST_THREADWISE_SLASH_TOKEN=
MEM0_API_KEY=
GROQ_API_KEY=

# Groq model defaults are configurable. Verify availability in your Groq account.
GROQ_FAST_MODEL=openai/gpt-oss-120b
GROQ_SUMMARY_MODEL=openai/gpt-oss-120b

COMMITMENT_DAYS=3
INACTIVITY_DAYS=14
DIGEST_TIME=09:00
TIMEZONE=UTC
ENABLE_WEBSOCKET=true
ENABLE_DIGESTS=true
MAX_THREAD_POSTS=100
